From 42e5d30061a959c888c58d6ff5d0b9f898a62359 Mon Sep 17 00:00:00 2001
From: Tigerly1 <49274205+Tigerly1@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:33:24 +0100
Subject: [PATCH] SwitchGLU kernels: fall back on edge cases and on the NAX
 path

- No tokens, top-k > 8, or scales in a different dtype than the input: use the generic path.
  Before: zero tokens failed to build the Metal library, k > 32 exceeded the threadgroup limit,
  mixed precision returned the input dtype instead of the promoted one.
- M5 and later: only below 4 tokens per expert, where MLX still runs gather_qmv.
  From 4 it runs the NAX kernels, which these kernels were not measured against.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 mlx_lm/models/switch_kernels.py | 28 ++++++++++++++++++++++------
 tests/test_switch_kernels.py    | 30 +++++++++++++++++++++++++++++-
 2 files changed, 51 insertions(+), 7 deletions(-)

diff --git a/mlx_lm/models/switch_kernels.py b/mlx_lm/models/switch_kernels.py
index 298f16e..0b1713a 100644
--- a/mlx_lm/models/switch_kernels.py
+++ b/mlx_lm/models/switch_kernels.py
@@ -562,9 +562,24 @@ def _make_op(act):
 _ops = {0: _make_op(0), 1: _make_op(1)}
 
 
-def max_load(D, F):
-    """Average tokens per expert (T*k/E) up to which these kernels beat gather_qmm (M4 Pro measurement)."""
-    return 24 if D * F >= 3 << 19 else 8
+def _nax_gpu():
+    """M5 and later, where gather_qmm runs the NAX kernels from 4 tokens per expert."""
+    gen = mx.device_info().get("architecture", "")[-3:-1]
+    return gen.isdigit() and int(gen) >= 17
+
+
+_nax = _kernels is not None and _nax_gpu()
+
+
+def supported_load(load, D, F):
+    """Whether these kernels are used at `load` = average tokens per expert (T*k/E).
+
+    M4 Pro: the measured crossover against gather_qmm. M5 and later: gather_qmm runs the NAX kernels
+    from 4; these kernels were not measured against them, so there they only replace gather_qmv.
+    """
+    if _nax:
+        return load < 4
+    return load <= (24 if D * F >= 3 << 19 else 8)
 
 
 def switch_glu(glu, x, indices):
@@ -579,12 +594,13 @@ def switch_glu(glu, x, indices):
             getattr(p, "group_size", None),
             getattr(p, "mode", "affine"),
         )
-        if fmt != (4, 64, "affine") or "bias" in p:
+        if fmt != (4, 64, "affine") or "bias" in p or p.scales.dtype != x.dtype:
             return None
     k = indices.shape[-1]
     T = indices.size // k
-    E, F, D = glu.gate_proj.weight.shape[0], glu.gate_proj.weight.shape[1], x.shape[-1]
-    if T * k / E > max_load(D, F):
+    (E, F), D = glu.gate_proj.weight.shape[:2], x.shape[-1]
+    # k <= 8: the T = 1 down kernel uses a (32, k) threadgroup
+    if T == 0 or k > 8 or not supported_load(T * k / E, D, F):
         return None
     weights = [a for p in projs for a in (p.weight, p.scales, p.biases)]
     y = _ops[act](x.reshape(T, D), indices.reshape(T, k).astype(mx.uint32), *weights)
diff --git a/tests/test_switch_kernels.py b/tests/test_switch_kernels.py
index 3992552..43cf334 100644
--- a/tests/test_switch_kernels.py
+++ b/tests/test_switch_kernels.py
@@ -49,12 +49,13 @@ class TestSwitchKernels(unittest.TestCase):
             for act in (SwiGLU(), GeGLU()):
                 glu = quantized_glu(D, F, E, act)
                 for dtype in (mx.bfloat16, mx.float16):
+                    glu.set_dtype(dtype)
                     for T in (1, 2, 3, 8, 17):
                         x = mx.random.normal((1, T, D)).astype(dtype)
                         idx = mx.argsort(mx.random.uniform(shape=(1, T, E)), axis=-1)[
                             ..., :k
                         ]
-                        if T * k / E > switch_kernels.max_load(D, F):
+                        if not switch_kernels.supported_load(T * k / E, D, F):
                             continue
                         y = switch_kernels.switch_glu(glu, x, idx)
                         self.assertIsNotNone(y)
@@ -66,6 +67,7 @@ class TestSwitchKernels(unittest.TestCase):
     def test_gradient_matches_generic_path(self):
         mx.random.seed(1)
         glu = quantized_glu(256, 384, 16)
+        glu.set_dtype(mx.bfloat16)
         x = mx.random.normal((1, 3, 256)).astype(mx.bfloat16)
         idx = mx.argsort(mx.random.uniform(shape=(1, 3, 16)), axis=-1)[..., :4]
         loss = lambda x: glu(x, idx).astype(mx.float32).sum()
@@ -86,11 +88,37 @@ class TestSwitchKernels(unittest.TestCase):
         idx = mx.zeros((1, 2, 4), mx.uint32)
         self.assertIsNone(switch_kernels.switch_glu(glu, x, idx))
         glu = quantized_glu(256, 384, 16)
+        # scales are fp32 here: the generic path would return fp32
+        self.assertIsNone(switch_kernels.switch_glu(glu, x, idx))
+        glu.set_dtype(mx.bfloat16)
+        self.assertIsNotNone(switch_kernels.switch_glu(glu, x, idx))
         self.assertIsNone(switch_kernels.switch_glu(glu, x.astype(mx.float32), idx))
         many = mx.zeros((1, 512, 4), mx.uint32)
         self.assertIsNone(
             switch_kernels.switch_glu(glu, mx.zeros((1, 512, 256), mx.bfloat16), many)
         )
+        # more experts per token than the T = 1 threadgroup allows
+        self.assertIsNone(
+            switch_kernels.switch_glu(glu, x, mx.zeros((1, 2, 9), mx.uint32))
+        )
+
+    def test_no_tokens(self):
+        glu = quantized_glu(256, 384, 16)
+        glu.set_dtype(mx.bfloat16)
+        x, idx = mx.zeros((1, 0, 256), mx.bfloat16), mx.zeros((1, 0, 4), mx.uint32)
+        self.assertEqual(glu(x, idx).shape, (1, 0, 4, 256))
+
+    def test_nax_gpu_keeps_gather_qmm_rhs(self):
+        glu = quantized_glu(256, 384, 16)
+        glu.set_dtype(mx.bfloat16)
+        x = lambda T: mx.zeros((1, T, 256), mx.bfloat16)
+        idx = lambda T: mx.zeros((1, T, 4), mx.uint32)
+        nax, switch_kernels._nax = switch_kernels._nax, True
+        try:
+            self.assertIsNotNone(switch_kernels.switch_glu(glu, x(15), idx(15)))
+            self.assertIsNone(switch_kernels.switch_glu(glu, x(16), idx(16)))
+        finally:
+            switch_kernels._nax = nax
 
 
 if __name__ == "__main__":
-- 
